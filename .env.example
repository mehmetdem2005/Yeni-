# =========================================================
# Crypto Paper Bot V3 — Environment Example
# Copy this file to .env locally or set these variables in Render/Vercel.
# Never commit real secrets.
# =========================================================

# Runtime
APP_ENV=local
HOST=127.0.0.1
PORT=8765
MIN_API_INTERVAL_SECONDS=10

# Database
# Local/Termux default uses SQLite if DATABASE_URL is empty.
# Supabase/Render should use a pooled Postgres URL.
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Groq AI Assistant
GROQ_API_KEY=
# Optional. Leave empty to auto-discover models from Groq /models.
# Example: GROQ_MODEL_ORDER=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it
GROQ_MODEL_ORDER=

# Binance
# Public data works without keys.
# Paper trade does not need Binance keys.
# Live trading must remain disabled until all paper-trade criteria pass.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENABLE_LIVE_TRADING=false
BINANCE_ENABLE_WITHDRAWALS=false

# News
NEWS_REFRESH_SECONDS=600
NEWS_WEIGHT_ENABLED=true

# AI homepage commentary
AI_COMMENTARY_REFRESH_SECONDS=600
AI_COMMENTARY_STYLE=mixed

# Trading / risk
DEFAULT_STARTING_BALANCE=10000
MAX_OPEN_POSITIONS=2
TRADE_CONFIDENCE_THRESHOLD=0.70
ACCOUNT_RISK_PCT=0.005
MAX_POSITION_PCT=0.05
MIN_POSITION_PCT=0.005

# UI
UI_THEME=light-soft
UI_MOBILE_FIRST=true
